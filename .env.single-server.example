# ===================================================
# DentiSys Single-Server Environment Template
# Private-LAN single-server deployment configuration
# ===================================================
#
# Copy this file to .env.single-server for controlled private-LAN testing.
# Do not commit the resulting credential-bearing file.
# Use .env.example for normal local Docker development.

# Application Runtime
# Single-server Compose fixes APP_ENV=single-server.
APP_ENV=single-server
# Absolute HTTP(S) URL required by single-server startup validation.
APP_BASE_URL=https://dentisys.example.edu
# Boolean: true or false. Set true when this deployment serves HTTPS.
APP_IS_HTTPS=false

# Application Ports
# Host-facing application port; the current template uses port 8080.
APP_HTTP_PORT=8080

# Database Configuration
# PostgreSQL remains internal to the Compose network; DB_HOST and DB_PORT are intentionally absent.
# Replace password placeholders before startup.
DB_NAME=dentisys
DB_USER=dentisys
DB_PASS=replace_with_application_password
DB_ADMIN_USER=postgres
DB_ADMIN_PASS=replace_with_postgres_admin_password

# SMTP Mailer Settings
# Single-server uses a real SMTP provider rather than normal-development Mailpit.
# Compose fixes EMAIL_PROVIDER=smtp.
EMAIL_PROVIDER=smtp
# SMTP_HOST is required by startup validation.
SMTP_HOST=replace_with_smtp_host
SMTP_PORT=587
# Leave SMTP_USER and SMTP_PASS blank only when the provider permits unauthenticated use.
SMTP_USER=
SMTP_PASS=
# SMTP_FROM is required by startup validation.
SMTP_FROM=replace_with_sender_email
# Allowed values: none, starttls, or tls.
SMTP_ENCRYPTION=starttls
# Boolean: true or false. Keep true for normal external SMTP use.
SMTP_VERIFY_PEER=true

# Email Domain and Google Identity
# Use DNS domains without the @ prefix and separate multiple domains with commas.
ALLOWED_EMAIL_DOMAINS=bicol-u.edu.ph
# ALLOWED_EMAIL_DOMAINS is the canonical current setting.
# Leave blank to disable Google provider/UI configuration.
GOOGLE_CLIENT_ID=

# Security Keys
# Replace these placeholders with suitable generated keys before deployment.
JWT_SIGNING_KEY_B64=replace_with_base64_32_byte_key
MFA_ENCRYPTION_KEY_B64=replace_with_base64_32_byte_key
AUDIT_MAC_KEY_B64=replace_with_base64_32_byte_key

# Developer Presentation and Prototype Toggles
# Boolean values: true or false. Single-server Compose keeps these disabled.
DEV_MOCK_IDENTITY_ENABLED=false
DEV_MOCK_BIOMETRIC_ENABLED=false
DEV_MOCK_LOCATION_ENABLED=false
DEV_BROWSER_ATTENDANCE_PROTOTYPE_ENABLED=false

# Student Authentication Toggle
# Boolean: true or false.
# This gates the supported Student authentication and invitation/activation flow.
# It does not enable unavailable Student academic APIs or other academic functionality.
STUDENT_AUTH_ENABLED=false
