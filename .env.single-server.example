APP_ENV=single-server
APP_BASE_URL=https://dentisys.example.edu
APP_IS_HTTPS=false
APP_HTTP_PORT=8080
DB_NAME=dentisys
DB_USER=dentisys
DB_PASS=replace_with_application_password
DB_ADMIN_USER=postgres
DB_ADMIN_PASS=replace_with_postgres_admin_password
SMTP_HOST=replace_with_smtp_host
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=replace_with_sender_email
SMTP_ENCRYPTION=starttls
SMTP_VERIFY_PEER=true
ALLOWED_EMAIL_DOMAIN=bicol-u.edu.ph
JWT_SIGNING_KEY_B64=replace_with_base64_32_byte_key
MFA_ENCRYPTION_KEY_B64=replace_with_base64_32_byte_key
AUDIT_MAC_KEY_B64=replace_with_base64_32_byte_key
