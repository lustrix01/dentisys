# ===================================================
# DentiSys Local Environment Template
# Docker Compose PostgreSQL development configuration
# ===================================================
#
# Copy this file to .env for normal local development.
# Do not commit .env or place real credentials in this template.
# For the private-LAN single-server prototype, use .env.single-server.example.

# Application Runtime
# Allowed values: development, test, single-server, production.
# The normal local Compose stack uses development.
APP_ENV=development
# Absolute HTTP(S) application URL with no query string or fragment.
APP_BASE_URL=http://localhost:5173
# Boolean: true or false. Set true when the public URL is HTTPS.
APP_IS_HTTPS=false
# Boolean: true or false. The normal development stack keeps debugging disabled.
APP_DEBUG=false

# Application Ports
# Use available host port numbers.
BACKEND_HTTP_PORT=8080
FRONTEND_HTTP_PORT=5173
PGADMIN_HTTP_PORT=5050

# Database Configuration
# Normal Compose uses these values for the web container.
DB_HOST=db
DB_PORT=5432
DB_NAME=dentisys
DB_USER=dentisys
DB_PASS=local-development-password
DB_ADMIN_USER=postgres
DB_ADMIN_PASS=local-postgres-admin-password
PGADMIN_DEFAULT_EMAIL=admin@dentisys.dev
PGADMIN_DEFAULT_PASSWORD=local-pgadmin-password

# SMTP Mailer Settings
# Normal development Compose routes mail through the mailpit service.
# Single-server mode uses the SMTP values from .env.single-server.example.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@dentisys.local
# Allowed values: none, starttls, or tls.
SMTP_ENCRYPTION=none
# Boolean: true or false. Production-like SMTP requires true.
SMTP_VERIFY_PEER=false
# Optional CA certificate path. The backend supports this for SMTP deployments,
# but the provided Compose files do not forward it to the web container.
SMTP_CA_FILE=
# Allowed values: mailpit or smtp. Mailpit is restricted to development/test.
EMAIL_PROVIDER=mailpit
MAILPIT_UI_PORT=8025

# Email Domain and Google Identity
# Use DNS domains without the @ prefix and separate multiple domains with commas.
# Example: bicol-u.edu.ph,gmail.com
ALLOWED_EMAIL_DOMAINS=bicol-u.edu.ph
# ALLOWED_EMAIL_DOMAINS is canonical for new configuration. The backend retains
# the singular setting as a compatibility fallback for older deployments.
# Leave blank to disable Google provider/UI configuration.
GOOGLE_CLIENT_ID=

# Security Keys
# These are safe development placeholders. Replace them for non-development use.
JWT_SIGNING_KEY_B64=ZGVudGlzeXMtZGV2LWp3dC1zaWduaW5nLWtleS0zMmI=
MFA_ENCRYPTION_KEY_B64=ZGVudGlzeXMtZGV2LW1mYS1lbmNyeXB0LWtleS0zMmI=
AUDIT_MAC_KEY_B64=ZGVudGlzeXMtZGV2LWF1ZGl0LW1hYy1rZXktMzJiaXQ=

# Developer Presentation and Prototype Toggles
# Boolean values: true or false.
# These are development conveniences and labeled prototypes; keep them false for real Student testing.
SHOW_DEV_RESET_LINK=true
SHOW_DEV_INVITATION_LINK=true
DEV_MOCK_IDENTITY_ENABLED=false
DEV_MOCK_BIOMETRIC_ENABLED=false
DEV_MOCK_LOCATION_ENABLED=false
DEV_BROWSER_ATTENDANCE_PROTOTYPE_ENABLED=false

# Student Authentication Toggle
# Boolean: true or false.
# This gates Student invitation/activation and the server-issued development mock session.
# Existing password/Google Student authentication has separate eligibility rules.
STUDENT_AUTH_ENABLED=false

# Private biometric sidecar. Leave the URL and secret blank until the sidecar
# calibration has been validated; real biometric routes never use the mock.
BIOMETRIC_SIDECAR_URL=
BIOMETRIC_SIDECAR_SHARED_SECRET=
BIOMETRIC_STORAGE_KEY_B64=
# Calibration values are intentionally unset here; they require approved
# device/pipeline validation before real biometric capture is enabled.
BIOMETRIC_HAAR_SCALE_FACTOR=
BIOMETRIC_HAAR_MIN_NEIGHBORS=
BIOMETRIC_HAAR_MIN_FACE_PX=
BIOMETRIC_QUALITY_LAPLACIAN_VARIANCE=
BIOMETRIC_LBPH_RADIUS=
BIOMETRIC_LBPH_NEIGHBORS=
BIOMETRIC_LBPH_GRID_X=
BIOMETRIC_LBPH_GRID_Y=
BIOMETRIC_LBPH_THRESHOLD=
BIOMETRIC_MATCH_COUNT=
BIOMETRIC_BLINK_THRESHOLD=
BIOMETRIC_HEAD_TURN_RATIO=
# Keep the deployment-provided model outside the repository. The default points
# to the approved sibling artifact directory; replace it only with another
# external, read-only model path.
MEDIAPIPE_FACE_LANDMARKER_MODEL_HOST_PATH=../dentisys-biometric-assets/face_landmarker.task
MEDIAPIPE_FACE_LANDMARKER_SHA256=
BIOMETRIC_CHALLENGE_TTL_SECONDS=120

# Advanced backend-only overrides
# The following are supported by PHP but are not passed into the web container by
# the provided Compose files, so these comments do not affect normal Compose deployments.
# Keep them commented unless Compose wiring is intentionally changed for a supported deployment.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# JWT_ACCESS_TTL=86400
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_STORAGE_DIR=
